generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReadStatus {
  READ
  WANT_TO_READ
}

model Book {
  id               Int      @id @default(autoincrement())
  googleBooksId    String?  @unique
  title            String
  author           String
  genres           Json
  pageCount        Int?
  publishedYear    Int?
  averageRating    Float?
  createdAt        DateTime @default(now())
  userBooks        UserBook[]
}

model User {
  id              Int @id @default(autoincrement())
  email           String @unique
  hashedPassword  String
  createdAt       DateTime @default(now())
  userBooks       UserBook[]
}

model UserBook {
  id              Int @id @default(autoincrement())
  userId          Int
  bookId          Int 
  status          ReadStatus
  rating          Int?
  addedAt         DateTime @default(now())
  user            User @relation(fields: [userId], references: [id])
  book            Book @relation(fields: [bookId], references: [id])

  @@unique([userId,bookId])
}
